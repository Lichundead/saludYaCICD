# ─── Configuración del backend de SaludYa ───
# Copia este archivo a .env y ajusta los valores. En producción, DATABASE_URL
# y JWT_SECRET son OBLIGATORIOS (el servidor no arranca sin ellos).

# Entorno: development | test | production
NODE_ENV=development

# Puerto del servidor (Render lo inyecta automáticamente en producción)
PORT=3001

# Nivel de log de pino: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# ─── Base de datos ───
# PostgreSQL gestionado (Neon, Supabase, etc.). Si se omite en desarrollo,
# se usa PGlite (Postgres embebido) en ./pgdata.
# DATABASE_URL=postgresql://usuario:clave@host/basedatos?sslmode=require
DATABASE_SSL=true
DB_POOL_MAX=10
# PGLITE_DIR=./pgdata

# ─── Seguridad ───
# Secreto largo y aleatorio para firmar los JWT (obligatorio en producción).
# Genéralo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos por CORS, separados por coma.
# CORS_ORIGINS=https://salud-ya-cicd.vercel.app

# Límites de peticiones por IP cada 15 minutos.
AUTH_RATE_LIMIT=20
GLOBAL_RATE_LIMIT=300

# Tamaño máximo del cuerpo JSON.
BODY_LIMIT=10kb

# ─── Correo (Mailtrap.io) ───
# Token de la API de Mailtrap. Sin él, el envío de correos queda deshabilitado.
# MAILTRAP_API_TOKEN=
#
# SANDBOX (Email Testing): define el id de tu inbox. Los correos NO se entregan;
# se capturan en tu inbox de Mailtrap, así la recuperación funciona para CUALQUIER
# usuario y lees ahí la contraseña temporal. El id es el número de la URL del
# inbox: https://mailtrap.io/inboxes/<INBOX_ID>/messages
# MAILTRAP_INBOX_ID=
#
# ENVÍO REAL (Email Sending): deja MAILTRAP_INBOX_ID vacío. Con el dominio demo
# solo entrega a tu propio correo hasta verificar un dominio propio.
# En sandbox el remitente es indiferente (el correo se captura, no se entrega).
MAIL_FROM=SaludYa <no-reply@saludya.com>

# ─── Aprovisionar admin (solo para `pnpm db:create-admin`) ───
# Define estas variables temporalmente para crear/actualizar la cuenta admin.
# No las dejes en un .env versionado ni compartido.
# ADMIN_EMAIL=admin@tu-dominio.com
# ADMIN_PASSWORD=
# ADMIN_NOMBRE=Administrador
